{
  "name": "project-drawing-status",
  "version": "1.0.0",
  "private": true,
  "description": "Project Drawing Status \u2014 a copy of the Design Goals & Delivery Control System with role-based sign-in (Next.js + PostgreSQL)",
  "scripts": {
    "db:setup": "tsx scripts/db-setup.ts",
    "db:reset": "tsx scripts/db-setup.ts --reset",
    "migrate:excel": "tsx scripts/migrate-excel.ts",
    "inspect:excel": "tsx scripts/inspect-workbooks.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsx scripts/e2e-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "fy26:import": "tsx scripts/fy26-import.ts",
    "drawings:import": "tsx scripts/drawings-import.ts",
    "projects:import": "tsx scripts/projects-import.ts",
    "data:repair": "tsx scripts/data-repair.ts",
    "logins:set": "tsx scripts/logins-set.ts",
    "lint": "next lint --dir src --dir scripts --dir tests",
    "typecheck": "tsc --noEmit -p .",
    "versions": "node scripts/versions.mjs list",
    "versions:save": "node scripts/versions.mjs save",
    "rollback": "node scripts/versions.mjs rollback"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.1",
    "next": "15.2.4",
    "pg": "^8.23.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.1",
    "xlsx": "0.18.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/pg": "^8.23.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "^0.30.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.2.4",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.9",
    "@types/bcryptjs": "2.4.6"
  },
  "engines": {
    "node": ">=20"
  }
}
