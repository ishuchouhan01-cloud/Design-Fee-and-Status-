# ---- Database (PostgreSQL) ------------------------------------------------
# Required. The application no longer supports SQLite.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/project_drawing_status"

# The test suite uses a SEPARATE database and drops its schema on every run.
# Leave unset to use "<database>_test" on the same server.
# TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/project_drawing_status_test"

# Connection pool size per application process.
DB_POOL_MAX=10
# Set true for a managed PostgreSQL service that requires TLS.
DB_SSL=false

# ---- PostgreSQL client tools ---------------------------------------------
# Needed for backup/restore (pg_dump, pg_restore). Leave blank if they are on
# PATH; on Windows they usually are not:
# PG_BIN_DIR="C:\Program Files\PostgreSQL\17\bin"
PG_BIN_DIR=

# ---- App ------------------------------------------------------------------
PORT=3100
APP_BASE_URL="http://localhost:3000"

# ---- Personal sign-in (Settings → Members) --------------------------------
# The first Account Admin: `npm run members:migrate` (or the launcher, once,
# when no Account Admin exists) adds this person and prints a one-time link
# to set their password. No password goes in this file.
INITIAL_ACCOUNT_ADMIN_EMAIL=
INITIAL_ACCOUNT_ADMIN_NAME=
# The shared Viewer / Admin / Super Admin sign-ins. Default on; set to false
# once everyone signs in with their own email (Super Admin's password stays
# as the emergency sign-in at /login?emergency=1).
LEGACY_ROLE_LOGINS=true

# ---- Excel migration source files ----------------------------------------
# Absolute or relative paths. Never hard-code user-specific paths in source.
EXCEL_GOALS_WORKBOOK="./import/Design Goals FY26-27 trial.xlsx"
EXCEL_PROJECT_PLAN_WORKBOOKS="./import/0118_Violet Hill_ 03YPlan_01012026 - Ph 1 trail.xlsx"
# IMPORT_DIR="./import"
# IMPORT_DERIVE_PACKAGE_LINKS=true
# PLAN_START_DATE=

# ---- Backup ---------------------------------------------------------------
# Must NOT be a OneDrive/SharePoint synchronised folder.
BACKUP_DIR="./backups"
BACKUP_RETENTION=20

# ---- Reporting tunables ---------------------------------------------------
# FISCAL_YEAR_START_MONTH=4
# Time zone for edit times shown as "Updated On" (IANA name). Default: Asia/Kolkata.
# APP_TIME_ZONE=Asia/Kolkata
# DUE_SOON_DAYS=14

# ---- Sign-in (Viewer · Admin · Super Admin) -------------------------------
# Signs the session cookies. The launcher writes one when it is missing.
# SESSION_SECRET=
# SESSION_HOURS=12
# The two passwords are read once, stored as bcrypt hashes, and can then be
# removed from this file (npm run logins:set sets new ones).
# ADMIN_PASSWORD=
# SUPER_ADMIN_PASSWORD=

# ---- First start of the copy ------------------------------------------------
# The original application's database: copied (read only) into DATABASE_URL
# when that database does not exist yet.
# CLONE_FROM_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/design_control"

# ---- Import ---------------------------------------------------------------
# Where uploaded workbooks wait between the dry run and the import.
# IMPORT_UPLOAD_DIR=
